# Claude Configuration
# Use Claude API (default) or CLI mode
CLAUDE_USE_CLI=false
# Anthropic API Key (required for API mode)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ===== Bitbucket Authentication =====
# Email: Your Atlassian account email
BITBUCKET_EMAIL=your-email@example.com
# API Token: Bitbucket -> Personal settings -> API tokens -> Create token
# Scopes: repository:read, pullrequest:read, pullrequest:write
BITBUCKET_API_TOKEN=your-api-token

# ===== Webhook Security =====
WEBHOOK_SECRET=your-webhook-secret

# ===== Server Configuration =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# ===== Repository Configuration (Optional) =====
DEFAULT_WORKSPACE=your-workspace

# ===== Review Configuration =====
# Language for code review comments: tr (Turkish), en (English)
REVIEW_LANGUAGE=tr

# Email Notification Configuration (OAuth2)
# Enable or disable email notifications
EMAIL_ENABLED=true
# Email provider (currently only 'gmail' supported for OAuth2)
EMAIL_PROVIDER=gmail
# Gmail address that will send notifications
EMAIL_SENDER_ADDRESS=your-email@gmail.com
# OAuth2 Credentials (get these by running: python tools/setup_gmail_oauth.py)
EMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
EMAIL_OAUTH_CLIENT_SECRET=your-client-secret
EMAIL_OAUTH_REFRESH_TOKEN=your-refresh-token

